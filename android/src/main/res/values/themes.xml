<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app draws everything itself; the window's own background is the connect screen's (ToolWindow.background:
         Islands Light #FFFFFF here, Islands Dark #191A1C in values-night), the first screen shown, so nothing flashes
         before the first frame. The system bars are made transparent in MainActivity (enableEdgeToEdge). -->
    <style name="Theme.Ideate" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ideate_window</item>
    </style>

    <color name="ideate_window">#FFFFFFFF</color>
</resources>
